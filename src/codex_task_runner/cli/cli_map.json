{
  "commands": [
    {
      "name": "ping",
      "help": "Ping a single URL and print result",
      "handler": "codex_task_runner.handlers.ping",
      "args": [
        {"flags": ["url"], "kwargs": {"help": "URL"}}
      ]
    },
    {
      "name": "poll",
      "help": "Poll a list of URLs from a file and save JSON",
      "handler": "codex_task_runner.handlers.poll",
      "args": [
        {"flags": ["urls_file"], "kwargs": {"help": "File with URLs"}},
        {"flags": ["out"], "kwargs": {"help": "Output JSON file", "nargs": "?", "default": "poll.json"}}
      ]
    },
    {
      "name": "tasks",
      "aliases": ["ls", "list"],
      "help": "List tasks from Codex Cloud",
      "handler": "codex_task_runner.handlers.tasks",
      "args": [
        {"flags": ["--limit"], "kwargs": {"type": "int", "default": 20, "help": "Max items"}},
        {"flags": ["--filter"], "kwargs": {"choices": ["current", "archived", "all"], "default": "current", "help": "Task filter"}}
      ]
    },
    {
      "name": "task",
      "aliases": ["t", "show"],
      "help": "Fetch single task detail",
      "handler": "codex_task_runner.handlers.task",
      "args": [
        {"flags": ["task_id"], "kwargs": {"help": "Task ID"}}
      ]
    },
    {
      "name": "turns",
      "help": "Fetch turns for a task",
      "handler": "codex_task_runner.handlers.turns",
      "args": [
        {"flags": ["task_id"], "kwargs": {"help": "Task ID"}}
      ]
    },
    {
      "name": "create-pr",
      "aliases": ["pr"],
      "help": "Create PR for a task turn (calls Codex API)",
      "handler": "codex_task_runner.handlers.create_pr",
      "args": [
        {"flags": ["task_id"], "kwargs": {"help": "Task ID"}},
        {"flags": ["turn_id"], "kwargs": {"help": "Turn ID"}},
        {"flags": ["--dry-run"], "kwargs": {"action": "store_true", "help": "Do not create PR"}}
      ]
    },
    {
      "name": "run",
      "help": "Run integration: fetch tasks and process (dry-run default)",
      "handler": "codex_task_runner.handlers.run",
      "args": [
        {"flags": ["--dry-run"], "kwargs": {"action": "store_true", "help": "Dry run"}},
        {"flags": ["--yolo"], "kwargs": {"action": "store_true", "help": "Full auto: skip checks, admin merge, delete branches"}},
        {"flags": ["--output-dir"], "kwargs": {"help": "Output directory", "default": null}}
      ]
    },
    {
      "name": "yolo",
      "aliases": ["go", "auto"],
      "help": "YOLO: create PRs and merge tasks (with safeguards)",
      "handler": "codex_task_runner.handlers.yolo",
      "args": [
        {"flags": ["-v", "--verbose"], "kwargs": {"action": "store_true", "help": "Verbose logging"}},
        {"flags": ["--limit"], "kwargs": {"type": "int", "default": 5, "help": "Max tasks to process (default: 5)"}},
        {"flags": ["--repo"], "kwargs": {"default": "johndoe6345789/metabuilder", "help": "Only process tasks for this repo"}},
        {"flags": ["--no-confirm"], "kwargs": {"action": "store_true", "help": "Skip confirmation prompt"}},
        {"flags": ["--dry-run"], "kwargs": {"action": "store_true", "help": "Show what would happen without doing it"}},
        {"flags": ["--create-followup"], "kwargs": {"action": "store_true", "help": "Auto-create follow-up tasks for non-mergeable PRs"}},
        {"flags": ["--output-dir"], "kwargs": {"help": "Output directory", "default": null}}
      ]
    },
    {
      "name": "dedup-prs",
      "aliases": ["dedup"],
      "help": "Find and close duplicate PRs, keeping the newest",
      "handler": "codex_task_runner.handlers.dedup_prs",
      "args": [
        {"flags": ["--repo"], "kwargs": {"default": "johndoe6345789/metabuilder", "help": "Repository to check"}},
        {"flags": ["--dry-run"], "kwargs": {"action": "store_true", "help": "Show duplicates without closing"}}
      ]
    },
    {
      "name": "usage",
      "help": "Show Codex usage stats",
      "handler": "codex_task_runner.handlers.usage",
      "args": []
    },
    {
      "name": "envs",
      "help": "List Codex environments",
      "handler": "codex_task_runner.handlers.envs",
      "args": [
        {"flags": ["--recent"], "kwargs": {"action": "store_true", "help": "Show only recent environments"}}
      ]
    },
    {
      "name": "repos",
      "help": "List connected GitHub repositories",
      "handler": "codex_task_runner.handlers.repos",
      "args": [
        {"flags": ["--page"], "kwargs": {"type": "int", "default": 1, "help": "Page number"}},
        {"flags": ["--per-page"], "kwargs": {"type": "int", "default": 10, "help": "Items per page"}}
      ]
    },
    {
      "name": "me",
      "aliases": ["whoami"],
      "help": "Show current user info",
      "handler": "codex_task_runner.handlers.me",
      "args": []
    },
    {
      "name": "settings",
      "help": "Show Codex user settings",
      "handler": "codex_task_runner.handlers.settings",
      "args": []
    },
    {
      "name": "discover",
      "help": "Discover Codex API endpoints via browser interception",
      "handler": "codex_task_runner.handlers.discover",
      "args": [
        {"flags": ["--output"], "kwargs": {"default": "discovered_endpoints.json", "help": "Output JSON file"}},
        {"flags": ["--timeout"], "kwargs": {"type": "int", "default": 30, "help": "Seconds to wait for manual exploration (0 = unlimited)"}},
        {"flags": ["--headless"], "kwargs": {"action": "store_true", "help": "Run browser in headless mode"}}
      ]
    },
    {
      "name": "archive",
      "aliases": ["done", "close"],
      "help": "Archive a Codex task",
      "handler": "codex_task_runner.handlers.archive",
      "args": [
        {"flags": ["task_id"], "kwargs": {"help": "Task ID to archive"}}
      ]
    },
    {
      "name": "patch",
      "aliases": ["diff", "p"],
      "help": "Extract git patch from a Codex task",
      "handler": "codex_task_runner.handlers.patch",
      "args": [
        {"flags": ["task_id"], "kwargs": {"help": "Task ID"}},
        {"flags": ["--turn-id"], "kwargs": {"help": "Specific turn ID (default: current turn)"}},
        {"flags": ["--raw"], "kwargs": {"action": "store_true", "help": "Output raw patch only (for piping to git apply)"}},
        {"flags": ["-o", "--output"], "kwargs": {"help": "Save patch to file"}}
      ]
    },
    {
      "name": "ui",
      "aliases": ["gui", "app"],
      "help": "Launch PyQt6 desktop GUI",
      "handler": "codex_task_runner.handlers.ui",
      "args": []
    },
    {
      "name": "prompt",
      "aliases": ["send", "new"],
      "help": "Send a prompt to Codex to create a new task",
      "handler": "codex_task_runner.handlers.prompt",
      "args": [
        {"flags": ["prompt_text"], "kwargs": {"help": "The prompt text to send to Codex"}},
        {"flags": ["--env-id"], "kwargs": {"help": "Environment ID (default: most recent)"}},
        {"flags": ["--branch"], "kwargs": {"default": "main", "help": "Branch name (default: main)"}},
        {"flags": ["--best-of"], "kwargs": {"type": "int", "default": 1, "help": "Number of responses to generate (default: 1)"}}
      ]
    },
    {
      "name": "serve",
      "aliases": ["server", "api", "flask"],
      "help": "Start Flask API server",
      "handler": "codex_task_runner.handlers.serve",
      "args": [
        {"flags": ["--host"], "kwargs": {"default": "127.0.0.1", "help": "Host to bind to (default: 127.0.0.1)"}},
        {"flags": ["--port"], "kwargs": {"type": "int", "default": 5000, "help": "Port to bind to (default: 5000)"}},
        {"flags": ["--debug"], "kwargs": {"action": "store_true", "help": "Enable debug mode"}}
      ]
    },
    {
      "name": "convert-md",
      "aliases": ["md-to-wiki"],
      "help": "Convert a Markdown file to MediaWiki wikitext (.wiki)",
      "handler": "codex_task_runner.cli_helpers.convert_md_to_wikitext",
      "args": [
        {"flags": ["src"], "kwargs": {"nargs": "?", "help": "Source markdown file (default: docs/MCP_SESSION_AND_APP.md)"}},
        {"flags": ["dest"], "kwargs": {"nargs": "?", "help": "Destination .wiki file (default: src stem + .wiki)"}}
      ]
    },
    {
      "name": "publish-mcp",
      "aliases": ["publish-wiki", "publish-mw"],
      "help": "Publish a markdown document to a MediaWiki instance (requires bot credentials)",
      "handler": "codex_task_runner.cli_helpers.publish_to_wiki",
      "args": [
        {"flags": ["username"], "kwargs": {"help": "MediaWiki bot username"}},
        {"flags": ["password"], "kwargs": {"help": "MediaWiki bot password"}},
        {"flags": ["--title"], "kwargs": {"help": "Page title to write (default: MCP Integration)", "default": "MCP Integration"}},
        {"flags": ["--docpath"], "kwargs": {"help": "Path to markdown document to publish (optional)"}},
        {"flags": ["--api"], "kwargs": {"help": "MediaWiki API endpoint (default: http://localhost:8080/api.php)", "default": "http://localhost:8080/api.php"}}
      ]
    },
    {
      "name": "compute-coverage",
      "aliases": ["coverage"],
      "help": "Compute React→QML component coverage for fakemui",
      "handler": "codex_task_runner.cli_helpers.compute_coverage",
      "args": [
        {"flags": ["--qmldir"], "kwargs": {"help": "Path to qmldir file or directory", "nargs": "?"}},
        {"flags": ["--react-glob"], "kwargs": {"help": "Glob pattern(s) for React fake UI files", "nargs": "*", "default": []}}
      ]
    },
    {
      "name": "poll-codex",
      "aliases": ["poll-urls"],
      "help": "Poll a list of URLs using Codex session and save results",
      "handler": "codex_task_runner.cli_helpers.poll_codex_urls",
      "args": [
        {"flags": ["--env"], "kwargs": {"help": "Path to .env file (default: .env)", "default": ".env"}},
        {"flags": ["urls_file"], "kwargs": {"help": "File containing URLs to poll", "nargs": "?", "default": "urls.txt"}},
        {"flags": ["--out"], "kwargs": {"help": "Output JSON file", "default": "run_poll.json"}}
      ]
    },
    {
      "name": "run-to-github",
      "aliases": ["run-codex", "run-to-gh"],
      "help": "Fetch tasks from Codex and process them to GitHub (wrapper around run_codex_to_github)",
      "handler": "codex_task_runner.cli_helpers.run_codex_to_github",
      "args": [
        {"flags": ["--env"], "kwargs": {"help": "Path to .env file (default: .env)", "default": ".env"}},
        {"flags": ["--dry-run"], "kwargs": {"action": "store_true", "help": "Perform a dry run (do not push or merge)"}},
        {"flags": ["--limit"], "kwargs": {"type": "int", "default": 20, "help": "Max tasks to fetch/process"}}
      ]
    }
  ]
}
